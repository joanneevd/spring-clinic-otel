name: CI - Pipeline Spring Clinic OTEL

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  build-test-quality:
    name: Build, Test & Quality
    runs-on: ubuntu-latest

    # Define overall env used by job (visible to all steps)
    env:
      OTEL_EXPORTER_OTLP_ENDPOINT: ${{ secrets.DT_OTLP_ENDPOINT }}
      OTEL_EXPORTER_OTLP_HEADERS: "Authorization=Api-Token ${{ secrets.DT_API_TOKEN }}

    steps:

      # 1️⃣ OTEL instrumentation (HARUS STEP PERTAMA)
      - name: Instrument CI Job with OTEL
        uses: plengauer/opentelemetry-github/actions/instrument/job@v5
        with:
          secrets_to_redact: '["${{ github.token }}","${{ secrets.DT_API_TOKEN }}"]'

      # 2️⃣ Checkout code
      - name: Checkout source
        uses: actions/checkout@v4

      # 3️⃣ Setup Java 17
      - name: Setup JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
          cache: maven

      # 4️⃣ Cache Gradle/Maven (if needed)
      - name: Cache Maven
        uses: actions/cache@v3
        with:
          path: ~/.m2/repository
          key: ${{ runner.os }}-maven-${{ hashFiles('**/pom.xml') }}
          restore-keys: |
            ${{ runner.os }}-maven-

      # 5️⃣ Build
      - name: Build application
        run: mvn clean package -DskipTests

      # 6️⃣ Unit Tests
      - name: Run unit tests
        run: mvn test -DskipITs

      # 7️⃣ Integration Tests (if any)
      - name: Run integration tests
        run: mvn verify -DskipUnitTests

      # 8️⃣ Code Quality (example: SpotBugs)
      - name: Static Analysis - SpotBugs
        run: mvn spotbugs:check

      # 9️⃣ Code Style & Formatter (Checkstyle)
      - name: Check code style
        run: mvn checkstyle:check

      # 🔟 Upload test reports/artifacts
      - name: Upload test report artifacts
        uses: actions/upload-artifact@v4
        with:
          name: test-reports
          path: target/surefire-reports/

      # 1️⃣1️⃣ Package artifact (JAR)
      - name: Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: spring-clinic-otel-built
          path: target/*.jar
